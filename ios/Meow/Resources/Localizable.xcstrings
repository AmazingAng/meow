    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "Build and install": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建并安装"
          }
        }
      }
    },
    "Build the CLI from source on macOS or Linux. Install Go and GitHub CLI first, then sign in to GitHub with an account that can access the repository.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 或 Linux 上从源码构建 CLI。请先安装 Go 和 GitHub CLI，再使用有仓库访问权限的账号登录 GitHub。"
          }
        }
      }
    },
    "CLI source and installation guide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 源码与安装说明"
          }
        }
      }
    },
    "Can't change server": {},
