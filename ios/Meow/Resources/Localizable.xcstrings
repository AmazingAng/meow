    },
    "Delivered": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送达"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详细信息"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Device Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Key"
          }
        }
      }
    },
    "Discard and re-register": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃并重新注册"
          }
        }
      }
    },
    "Discard and switch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃并切换"
          }
        }
      }
    },
    "Discard replies and switch": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃回复并切换"
          }
        }
      }
    },
    "Discard saved replies?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃已保存的回复？"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "During Focus": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免打扰提醒"
          }
        }
      }
    },
    "Enter a full address such as https://meow.example.com.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整地址，例如 https://meow.example.com。"
          }
        }
      }
    },
    "Enter the full http:// or https:// address. If you host Meow on your computer, use its LAN address while your iPhone is on the same Wi-Fi. 127.0.0.1 on your iPhone points to the iPhone itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整的 http:// 或 https:// 地址。如果服务器运行在你的电脑上，请让 iPhone 连接同一 Wi-Fi，并填写电脑的局域网地址。iPhone 上的 127.0.0.1 指向手机自身。"
          }
        }
      }
    },
    "Expired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期"
          }
        }
      }
    },
    "Expired without an answer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期，未回答"
          }
        }
      }
    },
    "Expires in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 后过期"
          }
        }
      }
    },
