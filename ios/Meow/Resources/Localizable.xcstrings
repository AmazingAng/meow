      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载通知"
          }
        }
      }
    },
    "Can't reach %@. Check the address and that the server is running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@。请检查地址，并确认服务器正在运行。"
