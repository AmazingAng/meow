{
  "sourceLanguage": "en",
  "strings": {
    "%@ doesn't look like a Meow server. Check the address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 看起来不是 Meow 服务器，请检查地址。"
          }
        }
      }
    },
    "%@ · %lld groups": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 等 %lld 组"
          }
        }
      }
    },
    "%@ · %lld sources": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 等 %lld 个来源"
          }
        }
      }
    },
    "%@: All messages in this time range will be permanently deleted from this server and this iPhone, including messages hidden by search or filters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：将从服务器和这台 iPhone 永久删除此时间范围内的全部消息，包括被搜索或筛选隐藏的消息。"
          }
        }
      }
    },
    "%lld combined groups": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已合并 %lld 个分组"
          }
        }
      }
    },
    "%lld matching unread messages": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条匹配的未读消息"
          }
        }
      }
    },
    "1. Install and connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 安装并接入"
          }
        }
      }
    },
    "1. Read your Device Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 输入设备密钥"
          }
        }
      }
    },
    "1. Run this command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 运行这条命令"
          }
        }
      }
    },
    "2. Paste your Device Key when asked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 出现提示时粘贴 Device Key"
          }
        }
      }
    },
    "2. Send a test notification": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 发送测试通知"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "After Homebrew, or if already installed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 安装后，或已安装 CLI"
          }
        }
      }
    },
    "Agent notifications for Claude Code, Codex and your scripts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收 Claude Code、Codex 和脚本发来的 Agent 通知。"
          }
        }
      }
    },
    "Agents and scripts use your Device Key to send to this iPhone. The key can only send, never read or answer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 和脚本用你的 Device Key 给这台 iPhone 发通知。这个密钥只能发送，不能读取或回答。"
          }
        }
      }
    },
    "Agents use the Device Key to send to this iPhone. It can only send, never read or answer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 用 Device Key 给这台 iPhone 发通知。它只能发送，不能读取或回答。"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All caught up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "都看完了"
          }
        }
      }
    },
