    "Direct installation saves Meow in ~/.local/bin and checks its SHA-256 checksum. It starts setup for this server immediately; paste your Device Key when asked.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接安装会将 Meow 保存到 ~/.local/bin 并校验 SHA-256，随后立即接入当前服务器。看到提示后粘贴 Device Key 即可。"
          }
        }
      }
    },
    "Discard and re-register": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃并重新注册"
          }
