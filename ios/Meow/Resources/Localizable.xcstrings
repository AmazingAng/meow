    "Downloads and installation guide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载与安装说明"
          }
        }
      }
    },
    "During Focus": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免打扰提醒"
          }
        }
      }
