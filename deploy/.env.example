# Public hostname; point its DNS A/AAAA record at this server first.
MEOW_DOMAIN=meow.example.com

# From Apple Developer > Certificates, IDs & Profiles > Keys (an APNs key).
MEOW_APNS_KEY_ID=XXXXXXXXXX
MEOW_APNS_TEAM_ID=XXXXXXXXXX
MEOW_APNS_TOPIC=blue.meow.app

# Per-device limits (0 = unlimited).
MEOW_MAX_KEYS_PER_DEVICE=10
MEOW_MAX_PENDING_QUESTIONS=20
MEOW_MAX_DAILY_MESSAGES=1000

# Delete devices the app hasn't contacted for this long, e.g. 2160h (90 days). 0 = off.
MEOW_INACTIVE_DEVICE_TTL=0
