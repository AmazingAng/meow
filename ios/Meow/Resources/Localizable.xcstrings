{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ doesn't look like a Meow server. Check the address." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 看起来不是 Meow 服务器，请检查地址。"
          }
        }
      }
    },
    "1. Run this command" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 运行这条命令"
          }
        }
      }
    },
    "2. Paste your Device Key when asked" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
