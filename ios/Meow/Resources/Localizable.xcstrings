      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个问题已不存在。"
          }
        }
      }
    },
    "This question was already answered: “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个问题已经回答过了：“%@”。"
          }
        }
      }
    },
    "This saved reply was discarded when changing servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条已保存的回复在切换服务器时被放弃。"
          }
        }
      }
    },
    "Time Sensitive Notifications": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时效性通知"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "Today and yesterday": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天和昨天"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Turn on notifications": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开通知"
          }
        }
      }
    },
    "Turn them on in Settings so Meow can alert you. Without them, messages still arrive in the inbox.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中打开通知，以便 Meow 提醒你。不打开的话，消息仍会出现在收件箱里。"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
