    "Couldn't mark as read. %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法标为已读。%@"
          }
        }
      }
    },
    "Couldn't prepare saved reply records. Your server and records have been kept. Check available storage and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备已保存的回复记录，当前服务器和记录均已保留。请检查可用存储空间后重试。"
          }
        }
      }
    },
    "Couldn't read saved messages. (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取本机保存的消息。（%@）"
          }
        }
      }
    },
    "Couldn't remove saved messages. Your server has been kept. (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除本机保存的消息，已保留当前服务器。（%@）"
          }
        }
      }
    },
    "Couldn't remove the saved replies. Your server and replies have been kept. Please try again. (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除已保存的回复。服务器和回复均已保留，请重试。（%@）"
          }
        }
      }
    },
    "Couldn't save messages on this iPhone. (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此 iPhone 保存消息。（%@）"
          }
        }
      }
    },
    "Couldn't save the reply failure. Your original answer is still saved. (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存回复失败记录，原回复仍已保存在本机。（%@）"
          }
        }
      }
    },
    "Couldn't save this iPhone's credentials to the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把这台 iPhone 的凭证保存到钥匙串。"
          }
        }
      }
    },
    "Couldn't save your answer on this iPhone. It has not been sent. Please free up storage or restart Meow and try again. (%@)": {},
    "Create a new Device Key?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要创建新的 Device Key 吗？"
          }
        }
      }
    },
    "Create new Device Key…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新的 Device Key…"
          }
        }
      }
    },
    "Create new key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新密钥"
          }
        }
      }
    },
    "Creating a new key immediately disables the current key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新密钥后，当前密钥会立即失效。"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
