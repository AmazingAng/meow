    "Changing the server registers this iPhone again with a new Device Key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换服务器后，这台 iPhone 会重新注册并获得新的 Device Key。"
